@page "/print"
@rendermode InteractiveServer

@using System.Net.Http.Json
@using System.Net.Http.Headers
@inject IHttpClientFactory HttpClientFactory
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>Smart Print</PageTitle>

<h1>Smart Print</h1>

<div class="print-container">

    <div>
        <label>PDF Document</label>

        <InputFile OnChange="HandleFileSelected"
                   accept=".pdf,application/pdf" />
    </div>

    <br />

    <div>
        <label>Printer</label>

        <select @bind="selectedPrinter">
            @foreach (var printer in printers)
            {
                <option value="@printer">
                    @printer
                </option>
            }
        </select>
    </div>

    <br />

    <div>
        <label>Copies</label>

        <input type="number"
               min="1"
               @bind="copies" />
    </div>

    <br />

    <button @onclick="PrintDocument"
            disabled="@isPrinting">
        @(isPrinting ? "Printing..." : "Print Document")
    </button>

    @if (!string.IsNullOrEmpty(message))
    {
        <p>@message</p>
    }

</div>

@code {

    private List<string> printers = new();

    private string? selectedPrinter;

    private IBrowserFile? selectedFile;

    private int copies = 1;

    private bool isPrinting;

    private string? message;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var client = HttpClientFactory.CreateClient();

            printers = await client.GetFromJsonAsync<List<string>>(
                "http://localhost:5296/api/printers")
                ?? new List<string>();

            if (printers.Count > 0)
            {
                selectedPrinter = printers[0];
            }
        }
        catch (Exception ex)
        {
            message = $"Could not load printers: {ex.Message}";
        }
    }

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;

        message = $"Selected: {selectedFile.Name}";
    }

    private async Task PrintDocument()
    {
        message = "Print button clicked!";
        if (selectedFile == null)
        {
            message = "Please select a PDF file.";
            return;
        }

        isPrinting = true;
        message = "Submitting print job...";

        try
        {
            var client = HttpClientFactory.CreateClient();

            using var content = new MultipartFormDataContent();

            await using var fileStream = selectedFile.OpenReadStream(
                maxAllowedSize: 20 * 1024 * 1024);

            using var fileContent = new StreamContent(fileStream);

            fileContent.Headers.ContentType =
                new MediaTypeHeaderValue("application/pdf");

            content.Add(
                fileContent,
                "file",
                selectedFile.Name);

            var response = await client.PostAsync(
                "http://localhost:5296/api/printjobs",
                content);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadAsStringAsync();

                message = $"Print job submitted successfully. {result}";
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();

                message = $"Print server error ({(int)response.StatusCode}): {error}";
            }
        }
        catch (Exception ex)
        {
            message = $"Could not submit print job: {ex.Message}";
        }
        finally
        {
            isPrinting = false;
        }
    }
}